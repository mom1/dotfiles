[user]
  name = Stolpasov, Maksim
  email = {{ .email }}
[advice]
  addEmptyPathspec = false
  pushNonFastForward = false
  statusHints = false
[alias]
  a = add
  ap = add -p
  amc = am --continue
  b = branch
  bm = branch --merged
  bnm = branch --no-merged
  c = clone
  ca = commit --amend
  cane = commit --amend --no-edit
  cf = commit --fixup
  cm = commit --message
  co = checkout
  cob = checkout -b
  com = checkout master
  cp = cherry-pick
  d = diff
  dc = diff --cached
  dm = "!git branch --merged | grep -v '\\*' | xargs -n 1 git branch -d"
  dom = diff origin/master
  amend = commit --amend --reuse-message=HEAD
  fo = fetch origin
  fu = "!git log -n 16 --pretty=format:'%h %s' --no-merges | fzf | cut -c -7 | xargs -o git commit --fixup"
  g = grep --line-number
  mbhom = merge-base HEAD origin/master
  mff = merge --ff-only
  ol = log --pretty=oneline
  l = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit
  p = push
  pf = push --force-with-lease
  prb = pull --rebase
  r = restore
  ra = rebase --abort
  rc = rebase --continue
  ri = rebase --interactive
  rl = reflog
  riom = rebase --interactive origin/master
  rpo = remote prune origin
  s = status -sb
  sh = "!git log -n 16 --pretty=format:'%h %s' --no-merges | fzf | cut -c -7 | xargs -o git show"
  ss = "commit --message 'chore: snapshot' --no-gpg-sign"
  su = submodule update
  wd = diff --patience --word-diff
[branch]
  sort = -committerdate
[column]
  ui = auto
[core]
  editor = {{ lookPath "micro" | default "nano" }}
  excludesfile = ~/.config/git/ignore
  untrackedCache = true
  whitespace = trailing-space,space-before-tab
[diff]
  algorithm = histogram
  colorMoved = plain
  renamelimit = 8192
  renames = true
[fetch]
  all = true
  fsckobjects = false
  prune = true
  pruneTags = true
[filter "lfs"]
  clean = git-lfs clean -- %f
  smudge = git-lfs smudge -- %f
  process = git-lfs filter-process
  required = true
[gitget]
  root = ~/src

[init]
  defaultBranch = master
[merge]
  conflictStyle = zdiff3
[pager]
  branch = false
  grep = false
[pull]
  rebase = true
[push]
  autoSetupRemote = true
  default = current
  followTags = true
[rebase]
  autoSquash = true
  autoStash = true
  updateRefs = true
[receive]
  fsckobjects = true
[status]
  submoduleSummary = true
[tag]
  sort = version:refname
[transfer]
  fsckobjects = true
[trim]
  bases = master,gh-pages
{{- $ghPath := lookPath "gh" }}
{{- if $ghPath }}
[credential "https://github.com"]
  helper = !{{ $ghPath }} auth git-credential
[credential "https://gist.github.com"]
  helper = !{{ $ghPath }} auth git-credential
{{- end }}
[url "git@github.com:"]
  insteadOf = "gh:"
[url "git@gist.github.com:"]
  insteadOf = "gst:"
